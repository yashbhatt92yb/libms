<Window x:Class="ABCLibrary.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABC College Library - Login"
        Height="420"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F5F7FA">
        <Border Style="{StaticResource CardStyle}" Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="ABC College Library" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
                <TextBlock Text="Username" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                <TextBlock Text="Password" />
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                <Button Content="Login" Command="{Binding LoginCommand}" Height="38" Margin="0,8,0,8" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#D32F2F" TextWrapping="Wrap"/>
                <TextBlock Text="Default: admin / Admin@123" Opacity="0.7" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
