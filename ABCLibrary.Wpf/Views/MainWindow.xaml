<Window x:Class="ABCLibrary.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ABC College Library Management System"
        Height="820"
        Width="1300"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="#EEF2F7">
        <Border DockPanel.Dock="Left" Width="230" Background="#1F2937" Padding="16">
            <StackPanel>
                <TextBlock Text="ABC Library" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" />
                <Button Content="Refresh Dashboard" Command="{Binding RefreshDashboardCommand}" Margin="0,0,0,8" />
                <Button Content="Load Data" Command="{Binding LoadDataCommand}" Margin="0,0,0,8" />
                <Button Content="Add Sample Book" Command="{Binding AddSampleBookCommand}" Margin="0,0,0,8" />
                <Button Content="Add Sample Student" Command="{Binding AddSampleStudentCommand}" Margin="0,0,0,8" />
                <Button Content="Export Inventory" Command="{Binding ExportInventoryCommand}" Margin="0,0,0,8" />
                <Button Content="Backup Database" Command="{Binding BackupCommand}" Margin="0,0,0,8" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <UniformGrid Rows="1" Columns="4">
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Total Books" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalBooks}" FontSize="28"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Issued Books" FontWeight="SemiBold"/><TextBlock Text="{Binding IssuedBooks}" FontSize="28"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Overdue" FontWeight="SemiBold"/><TextBlock Text="{Binding OverdueBooks}" FontSize="28"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Students" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalStudents}" FontSize="28"/></StackPanel></Border>
                </UniformGrid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Issue Book" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                            <TextBlock Text="Barcode"/>
                            <TextBox Text="{Binding IssueBarcode}" Margin="0,4,0,8"/>
                            <TextBlock Text="Student Roll"/>
                            <TextBox Text="{Binding IssueRoll}" Margin="0,4,0,8"/>
                            <Button Content="Issue" Command="{Binding IssueBookCommand}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Return Book" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                            <TextBlock Text="Barcode"/>
                            <TextBox Text="{Binding ReturnBarcode}" Margin="0,4,0,8"/>
                            <Button Content="Return" Command="{Binding ReturnBookCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Books" FontWeight="Bold" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding Books}" AutoGenerateColumns="False" Height="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}"/>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Author" Binding="{Binding Author}"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Students" FontWeight="Bold" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding Students}" AutoGenerateColumns="False" Height="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Roll" Binding="{Binding RollNumber}"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="Dept" Binding="{Binding Department}"/>
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}">
                    <TextBlock Text="{Binding Message}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
